{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flisk.sh/project-schema.json",
  "title": "Flisk Project Configuration",
  "description": "Editor assistance for .tdk/project.json. The Flisk CLI remains the runtime source of truth.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "project",
    "phases",
    "optional_infra",
    "discovery"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "minTdkVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Oldest tdk CLI this project works with, as MAJOR.MINOR.PATCH. tdk doctor fails on an older CLI."
    },
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "pre_alpha",
        "alpha",
        "beta",
        "out_of_scope"
      ],
      "properties": {
        "pre_alpha": {
          "$ref": "#/definitions/phase"
        },
        "alpha": {
          "$ref": "#/definitions/phase"
        },
        "beta": {
          "$ref": "#/definitions/phase"
        },
        "out_of_scope": {
          "$ref": "#/definitions/phase"
        }
      }
    },
    "stacks": {
      "type": "object",
      "additionalProperties": true
    },
    "always_enabled_infra": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional_infra": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "monitoring",
        "elk",
        "debezium",
        "golden_image",
        "verdaccio"
      ],
      "properties": {
        "monitoring": {
          "type": "boolean"
        },
        "elk": {
          "type": "boolean"
        },
        "debezium": {
          "type": "boolean"
        },
        "golden_image": {
          "type": "boolean"
        },
        "verdaccio": {
          "type": "boolean"
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "paths"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "definitions": {
    "phase": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "description",
        "enabledStacks"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "enabledStacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
