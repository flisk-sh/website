#!/usr/bin/env bash
# Builds the site before every push and checks the built pages, as scripts/check.sh does. Needs Ruby 3.3 with
# `bundle install` done, and Node 22.
#   Turn on:   git config core.hooksPath .githooks
#   Skip once: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v bundle >/dev/null || ! bundle check >/dev/null 2>&1; then
  echo "pre-push: the site build needs Ruby 3.3 and 'bundle install' (see CONTRIBUTING.md). Push with --no-verify to skip." >&2
  exit 1
fi
bundle exec jekyll build --quiet
node scripts/check-claims.mjs --built
